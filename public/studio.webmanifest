{
  "name": "Zari & Loom Studio",
  "short_name": "Z&L Studio",
  "description": "Add pieces from your phone: snap or share photos, AI writes the listing.",
  "id": "/admin",
  "start_url": "/admin?source=app",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f4ef",
  "theme_color": "#082625",
  "icons": [
    { "src": "/studio/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/studio/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/studio/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add a piece", "url": "/admin/products?source=app#add", "icons": [{ "src": "/studio/icon-192.png", "sizes": "192x192" }] },
    { "name": "Orders", "url": "/admin/orders?source=app", "icons": [{ "src": "/studio/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/admin/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "photos", "accept": ["image/*", "image/jpeg", "image/png", "image/webp", "image/heic"] }] }
  }
}
